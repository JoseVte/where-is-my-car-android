<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:layout="@layout/custom_preference_category"
        app:iconSpaceReserved="false"
        app:title="@string/appearance">

        <io.josrom.whereismycar.ThemePreference
            app:iconSpaceReserved="false"
            app:key="theme_selection" />

        <io.josrom.whereismycar.LanguagePreference
            app:iconSpaceReserved="false"
            app:key="language_selection" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/custom_preference_category"
        app:iconSpaceReserved="false"
        app:title="@string/app_settings_header">

        <io.josrom.whereismycar.AppSettingsPreference
            android:key="app_settings_card"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:layout="@layout/custom_preference_category"
        app:iconSpaceReserved="false"
        app:title="@string/cloud_sync">

        <io.josrom.whereismycar.SyncPreference
            app:iconSpaceReserved="false"
            app:key="google_sync_card" />

    </PreferenceCategory>

    <Preference
        app:icon="@drawable/ic_more"
        app:key="help_support"
        app:title="@string/help_support" />

</PreferenceScreen>