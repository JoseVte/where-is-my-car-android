<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ExploreFragment">

    <fragment
        android:id="@+id/ExploreFragment"
        android:name="io.josrom.whereismycar.ExploreFragment"
        android:label=""
        tools:layout="@layout/fragment_explore">

        <action
            android:id="@+id/action_ExploreFragment_to_SettingsFragment"
            app:destination="@id/SettingsFragment" />
        <action
            android:id="@+id/action_ExploreFragment_to_LocationDetailsFragment"
            app:destination="@id/LocationDetailsFragment" />
        <action
            android:id="@+id/action_ExploreFragment_to_LocationHistoryFragment"
            app:destination="@id/LocationHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/LocationHistoryFragment"
        android:name="io.josrom.whereismycar.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" >
        <action
            android:id="@+id/action_LocationHistoryFragment_to_ExploreFragment"
            app:destination="@id/ExploreFragment" />
        <action
            android:id="@+id/action_LocationHistoryFragment_to_LocationDetailsFragment"
            app:destination="@id/LocationDetailsFragment" />
        <action
            android:id="@+id/action_LocationHistoryFragment_to_EditLocationFragment"
            app:destination="@id/EditLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="io.josrom.whereismycar.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/LocationDetailsFragment"
        android:name="io.josrom.whereismycar.LocationDetailsFragment"
        android:label="LocationDetailsFragment"
        tools:layout="@layout/fragment_location_details">
        <action
            android:id="@+id/action_LocationDetailsFragment_to_ExploreFragment"
            app:destination="@id/ExploreFragment" />
        <argument
            android:name="locationId"
            app:argType="integer" />
        <action
            android:id="@+id/action_LocationDetailsFragment_to_EditLocationFragment"
            app:destination="@id/EditLocationFragment" />
    </fragment>
    <fragment
        android:id="@+id/SettingsFragment"
        android:name="io.josrom.whereismycar.SettingsFragment"
        android:label="Settings" />
    <fragment
        android:id="@+id/EditLocationFragment"
        android:name="io.josrom.whereismycar.EditLocationFragment"
        android:label="EditLocationFragment"
        tools:layout="@layout/fragment_edit_location" >
        <argument
            android:name="locationId"
            app:argType="integer" />
    </fragment>
</navigation>