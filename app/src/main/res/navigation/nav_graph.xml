<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ExploreFragment">

    <fragment
        android:id="@+id/ExploreFragment"
        android:name="io.josrom.whereismycar.ExploreFragment"
        android:label=""
        tools:layout="@layout/fragment_explore">

        <action
            android:id="@+id/action_ExploreFragment_to_SettingsFragment"
            app:destination="@id/SettingsFragment" />
        <action
            android:id="@+id/action_ExploreFragment_to_LocationDetailsFragment"
            app:destination="@id/LocationDetailsFragment" />
        <action
            android:id="@+id/action_ExploreFragment_to_LocationHistoryFragment"
            app:destination="@id/LocationHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/LocationHistoryFragment"
        android:name="io.josrom.whereismycar.HistoryFragment"
        android:label="@string/history"
        tools:layout="@layout/fragment_history" >
        <action
            android:id="@+id/action_LocationHistoryFragment_to_ExploreFragment"
            app:destination="@id/ExploreFragment" />
        <action
            android:id="@+id/action_LocationHistoryFragment_to_LocationDetailsFragment"
            app:destination="@id/LocationDetailsFragment" />
        <action
            android:id="@+id/action_LocationHistoryFragment_to_EditLocationFragment"
            app:destination="@id/EditLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/LocationDetailsFragment"
        android:name="io.josrom.whereismycar.LocationDetailsFragment"
        android:label="LocationDetailsFragment"
        tools:layout="@layout/fragment_location_details">
        <action
            android:id="@+id/action_LocationDetailsFragment_to_ExploreFragment"
            app:destination="@id/ExploreFragment" />
        <argument
            android:name="locationId"
            app:argType="integer" />
        <action
            android:id="@+id/action_LocationDetailsFragment_to_EditLocationFragment"
            app:destination="@id/EditLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/SettingsFragment"
        android:name="io.josrom.whereismycar.SettingsFragment"
        android:label="@string/settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_SettingsFragment_to_ManageCategoriesFragment"
            app:destination="@id/ManageCategoriesFragment" />
        <action
            android:id="@+id/action_SettingsFragment_to_LocationHistoryFragment"
            app:destination="@id/LocationHistoryFragment" />
        <action
            android:id="@+id/action_SettingsFragment_to_ExploreFragment"
            app:destination="@id/ExploreFragment" />
        <action
            android:id="@+id/action_SettingsFragment_to_CloudSyncSettingsFragment"
            app:destination="@id/CloudSyncSettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/EditLocationFragment"
        android:name="io.josrom.whereismycar.EditLocationFragment"
        android:label="@string/edit_location"
        tools:layout="@layout/fragment_edit_location" >
        <argument
            android:name="locationId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/ManageCategoriesFragment"
        android:name="io.josrom.whereismycar.ManageCategoriesFragment"
        android:label="@string/manage_categories"
        tools:layout="@layout/fragment_manage_categories" >
        <action
            android:id="@+id/action_ManageCategoriesFragment_to_EditCategoryFragment"
            app:destination="@id/EditCategoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/EditCategoryFragment"
        android:name="io.josrom.whereismycar.EditCategoryFragment"
        android:label="@string/edit_category"
        tools:layout="@layout/fragment_edit_category" >
        <argument
            android:name="category_id"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

    <fragment
        android:id="@+id/CloudSyncSettingsFragment"
        android:name="io.josrom.whereismycar.CloudSyncSettingsFragment"
        android:label="@string/cloud_sync"
        tools:layout="@layout/fragment_cloud_sync_settings" />
</navigation>