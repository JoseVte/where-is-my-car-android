<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/LocationListFragment">

    <fragment
        android:id="@+id/LocationListFragment"
        android:name="io.josrom.whereismycar.LocationListFragment"
        android:label="@string/location_list_fragment_label"
        tools:layout="@layout/fragment_location_list">

        <action
            android:id="@+id/action_LocationListFragment_to_LocationDetailsFragment"
            app:destination="@id/LocationDetailsFragment" />
        <action
            android:id="@+id/action_LocationListFragment_to_SettingsFragment"
            app:destination="@id/SettingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/LocationDetailsFragment"
        android:name="io.josrom.whereismycar.LocationDetailsFragment"
        android:label="LocationDetailsFragment"
        tools:layout="@layout/fragment_location_details">
        <action
            android:id="@+id/action_LocationDetailsFragment_to_LocationListFragment"
            app:destination="@id/LocationListFragment" />
        <argument
            android:name="locationId"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/SettingsFragment"
        android:name="io.josrom.whereismycar.SettingsFragment"
        android:label="Settings" />
</navigation>