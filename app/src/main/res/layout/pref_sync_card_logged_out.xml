<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_logged_out"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_backup_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/backup_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_backup_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/backup_summary"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_backup_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google_signin"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/sign_in_google"
        android:textAllCaps="false"
        android:textColor="@color/app_background"
        app:backgroundTint="@color/text_primary"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_search"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/app_background"
        app:layout_constraintTop_toBottomOf="@id/tv_backup_summary" />

</androidx.constraintlayout.widget.ConstraintLayout>