<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WhereIsMyCar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/app_background</item>

        <!-- Material 3 Menu Styling -->
        <item name="android:popupMenuStyle">@style/Widget.Material3.PopupMenu.Custom</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu.Custom</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>

        <!-- Preference Styles -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <!-- Custom Attribute -->
        <item name="icon_color">@color/text_primary</item>
    </style>

    <style name="Theme.WhereIsMyCar" parent="Base.Theme.WhereIsMyCar" />

    <style name="PreferenceThemeOverlay" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/PreferenceCategoryStyle</item>
    </style>

    <!-- Custom Preference Category Style -->
    <style name="PreferenceCategoryStyle" parent="Preference.Category.Material">
        <item name="android:layout">@layout/custom_preference_category</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!-- Theme overlay specifically for Popups to ensure the custom style is applied -->
    <style name="Theme.WhereIsMyCar.PopupMenuOverlay" parent="">
        <item name="android:popupMenuStyle">@style/Widget.Material3.PopupMenu.Custom</item>
        <item name="popupMenuStyle">@style/Widget.Material3.PopupMenu.Custom</item>
        <item name="android:dropDownListViewStyle">@style/Widget.WhereIsMyCar.ListView.DropDown</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_menu_item_ripple</item>
    </style>

    <style name="Widget.WhereIsMyCar.ListView.DropDown" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:padding">8dp</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:listSelector">@drawable/bg_menu_item_ripple</item>
        <item name="android:clipToPadding">true</item>
    </style>

    <style name="Widget.Material3.PopupMenu.Custom" parent="Widget.Material3.PopupMenu">
        <item name="android:textAllCaps">false</item>
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation" tools:ignore="NewApi">16dp</item>
        <item name="android:dropDownHeight">wrap_content</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemRippleColor">@null</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemTextAppearanceActive">@style/NavTextAppearance</item>
        <item name="itemTextAppearanceInactive">@style/NavTextAppearance</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Switch</item>
        <item name="android:scaleX">0.8</item>
        <item name="android:scaleY">0.8</item>
        <item name="thumbIcon">@drawable/ic_check</item>
    </style>

    <style name="ThemeOverlay.App.Switch" parent="">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurfaceVariant">@color/primary_gray</item>
        <item name="colorSurfaceContainerHighest">@color/primary_gray_full</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
    </style>

    <style name="ToggleButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/toggle_btn_color</item>
        <item name="android:textColor">@color/toggle_text_color</item>
        <item name="iconTint">@color/toggle_text_color</item>
        <item name="strokeColor">@color/toggle_btn_color</item>
    </style>

    <!-- Save Button Style -->
    <style name="Widget.App.Button.Save" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="NavTextAppearance" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily" xmlns:tools="http://schemas.android.com/tools" tools:ignore="SpUsage">sans-serif-medium</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>